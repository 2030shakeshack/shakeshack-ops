{{ 'diwali-store.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="dw dw-usp" aria-label="{{ s.aria | escape }}" style="--dw-sec-bg:{{ s.c_bg }};--dw-acc:{{ s.c_icon }};--dw-esp:{{ s.c_title }};--dw-cols:{{ section.blocks.size | at_least: 1 }}">
  <div class="dw-wrap">
    <ul>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          {%- if b.image -%}
            {{ b.image | image_url: width: 56 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {%- case b.icon -%}
              {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="18" height="12" rx="1.5"/><path d="M3 13h18M12 9v12M12 9c-2-4-6-4-6-1.5S9 9 12 9zm0 0c2-4 6-4 6-1.5S15 9 12 9z"/></svg>
              {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
              {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/></svg>
              {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
              {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12a4 4 0 0 1 0 8H9"/><path d="M8 6l-4 4 4 4"/></svg>
              {%- when 'diya' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3 13h18c-1 4.5-4.5 7-9 7s-8-2.5-9-7z"/><path d="M12 3c1.8 2.3 2.3 4.2 1.2 5.9-.6 1-1.8 1-2.4 0C9.7 7.2 10.2 5.3 12 3z"/></svg>
            {%- endcase -%}
          {%- endif -%}
          <span><b>{{ b.title }}</b>{{ b.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Diwali: Promise strip",
  "tag": "div",
  "class": "dw-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "aria", "label": "Accessible label", "default": "Why gift from us" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#fbf4e8" },
    { "type": "color", "id": "c_icon", "label": "Icon colour", "default": "#e8913c" },
    { "type": "color", "id": "c_title", "label": "Title colour", "default": "#281a1b" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "gift",
          "options": [
            { "value": "gift", "label": "Gift" }, { "value": "truck", "label": "Truck" }, { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" }, { "value": "return", "label": "Return" }, { "value": "diya", "label": "Diya" }
          ] },
        { "type": "image_picker", "id": "image", "label": "Custom icon (overrides icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free gift wrap" },
        { "type": "text", "id": "text", "label": "Text", "default": "on every box" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diwali: Promise strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "gift", "title": "Free gift wrap", "text": "on every box" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Ships in 24 hrs", "text": "before Diwali" } },
        { "type": "item", "settings": { "icon": "star", "title": "4.5★ rated", "text": "by 1M+ men" } }
      ]
    }
  ]
}
{% endschema %}
