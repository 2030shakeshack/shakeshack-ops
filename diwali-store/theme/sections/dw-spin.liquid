{{ 'diwali-store.css' | asset_url | stylesheet_tag }}
<script src="{{ 'diwali-store.js' | asset_url }}" type="module"></script>
{%- assign s = section.settings -%}
<dw-spin
  class="dw dw-spin"
  id="{{ s.anchor | default: section.id | handleize }}"
  style="--dw-sec-bg:{{ s.c_bg }};--dw-esp:{{ s.c_text }};--dw-gold:{{ s.c_gold }};--dw-acc:{{ s.c_acc }};--dw-pt:{{ s.pt }}px;--dw-pb:{{ s.pb }}px;--dw-pt-d:{{ s.pt_d }}px;--dw-pb-d:{{ s.pb_d }}px"
>
  <div class="dw-wrap dw-spin-in">
    <div class="dw-spin-copy">
      <h2>{{ s.heading }}{% if s.heading_italic != blank %} <i>{{ s.heading_italic }}</i>{% endif %}</h2>
      {%- if s.lede != blank %}<p class="dw-lede">{{ s.lede }}</p>{% endif -%}
    </div>

    <div class="dw-wheel-box">
      <svg class="dw-pointer" viewBox="0 0 34 44" aria-hidden="true"><path d="M17 44L3 14a14 14 0 1 1 28 0z" fill="{{ s.c_acc }}" stroke="{{ s.c_text }}" stroke-width="2"/></svg>
      <svg class="dw-wheel" viewBox="0 0 400 400" aria-hidden="true" font-family="inherit">
        <circle cx="200" cy="200" r="196" fill="{{ s.c_gold }}"/>
        <circle cx="200" cy="200" r="190" fill="{{ s.c_text }}"/>
        <g class="dw-rot"><g data-slices></g></g>
        <circle cx="200" cy="200" r="178" fill="none" stroke="{{ s.c_gold }}" stroke-width="1.2" opacity=".7"/>
        <g data-dots></g>
      </svg>
      <button type="button" class="dw-hub" aria-label="Spin the wheel">{{ s.hub_label }}</button>
    </div>

    <div class="dw-spin-meta">
      {%- if s.lead != 'none' -%}
        <div class="dw-lead">
          {%- if s.lead != 'phone' -%}
            <div class="dw-fld"><label for="DwEmail-{{ section.id }}">{{ s.email_label }}</label><input id="DwEmail-{{ section.id }}" name="email" type="email" autocomplete="email" inputmode="email"></div>
          {%- endif -%}
          {%- if s.lead != 'email' -%}
            <div class="dw-fld"><label for="DwPhone-{{ section.id }}">{{ s.phone_label }}</label><input id="DwPhone-{{ section.id }}" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="14"></div>
          {%- endif -%}
          {%- if s.consent != blank -%}
            <label class="dw-pmsg" style="margin-top:0"><input type="checkbox" name="consent"><small>{{ s.consent }}</small></label>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.terms != blank %}<p class="dw-tc">{{ s.terms }}</p>{% endif -%}
      <div class="dw-prize" aria-live="polite" hidden>
        <small>{{ s.won_label }}</small>
        <b></b>
        <code title="Tap to copy"></code>
        <button type="button" class="dw-btn" data-apply>{{ s.apply_label }}</button>
        {%- if s.code_note != blank %}<p>{{ s.code_note }}</p>{% endif -%}
      </div>
    </div>
  </div>

  {%- if s.tab_show -%}
    <button type="button" class="dw-spinb" data-section="{{ section.id }}" aria-label="{{ s.tab_label | escape }}" style="--dw-acc:{{ s.c_acc }}">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2"/><path d="M12 3v7M12 14v7M3 12h7M14 12h7M5.6 5.6l5 5M13.4 13.4l5 5M18.4 5.6l-5 5M10.6 13.4l-5 5"/></svg>{{ s.tab_label }}</span>
    </button>
  {%- endif -%}

  <script type="application/json" data-dw-config>
    {
      "mode": {{ s.mode | json }},
      "api": {{ s.api_url | json }},
      "lead": {{ s.lead | json }},
      "autoApply": {{ s.auto_apply }},
      "key": {{ 'dw_spin_' | append: s.campaign | handleize | json }},
      "slices": [
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {
            "label": {{ b.label | json }},
            "prize": {{ b.prize_id | default: b.label | handleize | json }},
            "fill": {{ b.fill | json }},
            "color": {{ b.color | json }},
            "weight": {{ b.weight }},
            "code": {% if s.mode == 'static' %}{{ b.code | json }}{% else %}""{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "l": {
        "once": {{ s.once_msg | json }},
        "lead": {{ s.lead_msg | json }},
        "won": {{ s.hub_won | json }},
        "youWon": "You won {prize}",
        "copied": "Code copied",
        "applied": "Applied",
        "appliedToast": "{code} applied to your cart",
        "error": "Something went wrong. Please try again."
      }
    }
  </script>
</dw-spin>

{% schema %}
{
  "name": "Diwali: Spin the wheel",
  "tag": "section",
  "class": "dw-section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "spin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spin the Rangoli" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic line", "default": "every spin wins." },
    { "type": "text", "id": "lede", "label": "Intro", "default": "Every slice wins. Your prize applies to the cart." },
    { "type": "text", "id": "terms", "label": "Terms line", "default": "One spin per customer. Single-use code, valid till 10 Nov 2026." },

    { "type": "header", "content": "Discount codes" },
    { "type": "select", "id": "mode", "label": "Code mode", "default": "api",
      "options": [
        { "value": "api", "label": "Unique single-use code per spin (spin endpoint)" },
        { "value": "static", "label": "Fixed code per slice" }
      ],
      "info": "Unique mode: the endpoint picks the prize and creates a one-time code. Fixed mode shows each slice's code below. Those codes appear in the page source, so set them to once-per-customer in Discounts." },
    { "type": "url", "id": "api_url", "label": "Spin endpoint URL", "info": "The deployed spin-api worker, e.g. https://dw-spin.yourname.workers.dev/spin" },
    { "type": "text", "id": "campaign", "label": "Campaign ID", "default": "diwali-2026", "info": "Change it to let returning visitors spin again (browser memory only; the endpoint enforces its own limit)" },
    { "type": "checkbox", "id": "auto_apply", "label": "Apply the code to the cart automatically", "default": true },

    { "type": "header", "content": "Lead capture" },
    { "type": "select", "id": "lead", "label": "Ask before spinning", "default": "phone",
      "options": [
        { "value": "none", "label": "Nothing" }, { "value": "email", "label": "Email" },
        { "value": "phone", "label": "Phone" }, { "value": "either", "label": "Email or phone" }
      ],
      "info": "The endpoint uses this to allow one spin per customer" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Mobile number" },
    { "type": "inline_richtext", "id": "consent", "label": "Consent checkbox text (optional)", "info": "If set, the box must be ticked to spin" },
    { "type": "text", "id": "lead_msg", "label": "Missing details message", "default": "Enter your mobile number to spin" },

    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "hub_label", "label": "Centre button", "default": "SPIN" },
    { "type": "text", "id": "hub_won", "label": "Centre button after spin", "default": "WON" },
    { "type": "text", "id": "won_label", "label": "Prize eyebrow", "default": "You won" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "Apply to cart" },
    { "type": "text", "id": "code_note", "label": "Note under the code", "default": "Single use. Tap the code to copy." },
    { "type": "text", "id": "once_msg", "label": "Already spun message", "default": "One spin per customer" },

    { "type": "header", "content": "Floating tab" },
    { "type": "checkbox", "id": "tab_show", "label": "Show side “Spin & Win” tab", "default": true },
    { "type": "text", "id": "tab_label", "label": "Tab label", "default": "SPIN & WIN" },

    { "type": "header", "content": "Colours & spacing" },
    { "type": "color", "id": "c_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "c_text", "label": "Heading & wheel base", "default": "#281a1b" },
    { "type": "color", "id": "c_gold", "label": "Gold", "default": "#c9a24b" },
    { "type": "color", "id": "c_acc", "label": "Pointer & tab", "default": "#e8913c" },
    { "type": "range", "id": "pt", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "pb", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "pt_d", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb_d", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "slice",
      "name": "Slice",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "10% OFF" },
        { "type": "text", "id": "prize_id", "label": "Prize ID", "default": "off10", "info": "Must match a prize id in the endpoint's PRIZES config" },
        { "type": "color", "id": "fill", "label": "Slice colour", "default": "#281a1b" },
        { "type": "color", "id": "color", "label": "Text colour", "default": "#f7dfbd" },
        { "type": "range", "id": "weight", "label": "Win weight (fixed mode)", "min": 0, "max": 100, "step": 1, "default": 10, "info": "In unique mode the endpoint's weights decide" },
        { "type": "text", "id": "code", "label": "Code (fixed mode)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diwali: Spin the wheel",
      "blocks": [
        { "type": "slice", "settings": { "label": "10% OFF", "prize_id": "off10", "fill": "#281a1b", "color": "#f7dfbd", "weight": 30, "code": "DIWALI10" } },
        { "type": "slice", "settings": { "label": "FREE SHIPPING", "prize_id": "freeship", "fill": "#fbf4e8", "color": "#281a1b", "weight": 25, "code": "FREESHIP" } },
        { "type": "slice", "settings": { "label": "₹100 OFF", "prize_id": "flat100", "fill": "#e8913c", "color": "#281a1b", "weight": 20, "code": "PATAKHA100" } },
        { "type": "slice", "settings": { "label": "15% OFF", "prize_id": "off15", "fill": "#fbf4e8", "color": "#281a1b", "weight": 12, "code": "DIWALI15" } },
        { "type": "slice", "settings": { "label": "₹150 OFF", "prize_id": "flat150", "fill": "#281a1b", "color": "#f7dfbd", "weight": 8, "code": "RANGOLI150" } },
        { "type": "slice", "settings": { "label": "20% OFF", "prize_id": "off20", "fill": "#f7dfbd", "color": "#281a1b", "weight": 5, "code": "DIWALI20" } }
      ]
    }
  ]
}
{% endschema %}
